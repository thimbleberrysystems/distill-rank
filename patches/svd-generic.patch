diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 3c2a8e7..a12cf46 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1601,12 +1601,63 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
 }
 
 ggml_tensor * llama_model_base::create_tensor(llama_model_loader & ml, const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags) {
+    // distill-rank: transparently substitute an SVD-factorized weight. If the
+    // arch asks for "<name>.weight" and that fused tensor is absent but its
+    // "<name>.svd_vt" factor exists, load the factors instead. Works for every
+    // architecture because it sits in the shared tensor-creation path.
+    if (tn.suffix && std::string(tn.suffix) == "weight") {
+        const LLM_TN_IMPL vt_tn(tn.arch, tn.tensor, "svd_vt", tn.bid, tn.xid);
+        if (ml.get_tensor_meta(vt_tn.str().c_str()) != nullptr) {
+            return create_svd_tensor(ml, tn, ne, flags);
+        }
+    }
+
     const buft_list_t * buft_list_layer = tn.bid == -1 ? nullptr : pimpl->dev_layer.at(tn.bid).buft_list;
     return ml.create_tensor(
         hparams, &pimpl->cpu_buft_list, pimpl->dev_input.buft_list, pimpl->dev_output.buft_list, buft_list_layer,
         tn, ne, flags);
 }
 
+ggml_tensor * llama_model_base::create_svd_tensor(llama_model_loader & ml, const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags) {
+    // ne is the fused weight shape: {in, out} for a dense linear, or
+    // {in, out, n_expert} for a stacked MoE expert tensor.
+    const int64_t * d = ne.begin();
+    const size_t nd = ne.size();
+    GGML_ASSERT(nd >= 2 && "SVD factorization expects a 2D (or 3D MoE) weight");
+    const int64_t in       = d[0];
+    const int64_t out      = d[1];
+    const bool    is_moe   = nd >= 3;
+    const int64_t n_expert = is_moe ? d[2] : 0;
+
+    const LLM_TN_IMPL u_tn (tn.arch, tn.tensor, "svd_u",  tn.bid, tn.xid);
+    const LLM_TN_IMPL s_tn (tn.arch, tn.tensor, "svd_s",  tn.bid, tn.xid);
+    const LLM_TN_IMPL vt_tn(tn.arch, tn.tensor, "svd_vt", tn.bid, tn.xid);
+
+    // rank r is taken from the stored factors (so truncated-rank checkpoints work)
+    const ggml_tensor * vt_meta = ml.get_tensor_meta(vt_tn.str().c_str());
+    const int64_t r = vt_meta->ne[1];
+
+    // the factors are required once we've committed to the factorized path
+    const int sub_flags = flags & ~TENSOR_NOT_REQUIRED;
+
+    ggml_tensor * vt;
+    ggml_tensor * s;
+    ggml_tensor * u;
+    if (!is_moe) {
+        vt = create_tensor(ml, vt_tn, {in, r     }, sub_flags);
+        s  = create_tensor(ml, s_tn,  {r          }, sub_flags);
+        u  = create_tensor(ml, u_tn,  {r,  out    }, sub_flags);
+    } else {
+        vt = create_tensor(ml, vt_tn, {in, r,  n_expert}, sub_flags);
+        s  = create_tensor(ml, s_tn,  {r,      n_expert}, sub_flags);
+        u  = create_tensor(ml, u_tn,  {r,  out, n_expert}, sub_flags);
+    }
+
+    // use U as the handle the arch will hand to build_lora_mm(_id)
+    svd_ops[u] = llama_svd_op{ u, s, vt };
+    return u;
+}
+
