diff --git a/src/llama-graph.h b/src/llama-graph.h
index bf5be09..e67df6e 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -11,11 +11,24 @@
 #include <set>
 #include <functional>
 #include <map>
+#include <unordered_map>
 
 struct ggml_cgraph;
 struct ggml_context;
 struct ggml_tensor;
 
+// distill-rank: a linear weight W may be stored as its SVD factorization
+// W = U * diag(s) * Vt. The model-load path registers the factors here, keyed
+// by a handle tensor, and the universal linear ops (build_lora_mm / _id) emit
+// the factorized matmul chain instead of a single mul_mat. This makes low-rank
+// factorization architecture-agnostic: no per-model graph code is required.
+struct llama_svd_op {
+    struct ggml_tensor * u  = nullptr; // [r, out]    (or [r, out, n_expert] for MoE)
+    struct ggml_tensor * s  = nullptr; // [r]         (or [r, n_expert])
+    struct ggml_tensor * vt = nullptr; // [in, r]     (or [in, r, n_expert])
+};
+using llama_svd_map = std::unordered_map<const struct ggml_tensor *, llama_svd_op>;
+
 struct llama_cparams;
 struct llama_layer;
 
@@ -600,6 +613,7 @@ struct llm_graph_params {
 
     const llama_adapter_cvec     * cvec;
     const llama_adapter_loras    * loras;
+    const llama_svd_map          * svd;   // distill-rank: SVD-factorized weights (may be null)
     const llama_memory_context_i * mctx;
     const llama_cross            * cross;
 
@@ -689,6 +703,7 @@ struct llm_graph_params {
             gtype == other.gtype &&
             cvec  == other.cvec  &&
             loras == other.loras &&
+            svd   == other.svd   &&
             cross == other.cross;
     }
 };
